# Runtime
APP_HOST=0.0.0.0
APP_PORT=8000
ENGINE_INTERVAL_SECONDS=2
DATABASE_PATH=data/k_trading.sqlite3

# Kalshi BTC 15-minute event contracts
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_SERIES_TICKER=KXBTC15M
MARKET_TICKER_OVERRIDE=

# Authenticated real-time market-data feeds (BRTI + streaming order book).
# Live order submission remains disabled.
ENABLE_KALSHI_WS=true
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_PRIVATE_KEY_PEM=
CFBENCHMARKS_INDEX_ID=BRTI
BENCHMARK_STALE_SECONDS=5

# Paper trading
PAPER_STARTING_CASH=1000
AUTO_PAPER_TRADE=true
LIVE_TRADING_ENABLED=false

# Strategy / risk
MIN_USABLE_EDGE=0.04
EXIT_EDGE=0.01
UNCERTAINTY_BUFFER=0.02
ESTIMATED_COST_BUFFER=0.01
MAX_SPREAD=0.12
MAX_POSITION_USD=15
MAX_BANKROLL_FRACTION=0.015
MIN_SECONDS_TO_EXPIRY=45
OFFICIAL_REFERENCE_GUARD_SECONDS=75
MIN_WAVE_STRENGTH=0.08
MAX_TRADE_LOSS_FRACTION=0.25
TRAILING_PROFIT_ARM_FRACTION=0.10
TRAILING_GIVEBACK_FRACTION=0.35
# Realized paper loss allowed per UTC day; new entries are blocked until 00:00 UTC.
DAILY_LOSS_LIMIT_USD=50
MAX_DRAWDOWN_FRACTION=0.10

# V0.4 learning system
MODEL_DIR=data/models
ENABLE_LEARNED_MODEL=true
MODEL_MIN_WINDOWS=24
MODEL_MIN_BRIER_GAIN=0.002

# V0.5 execution simulator
EXECUTION_BOOK_DEPTH=20
SIM_TAKER_FEE_RATE=0.07
SIM_TAKER_FEE_MULTIPLIER=1.0
SIM_MAKER_FEE_RATE=0.0175
SIM_MAKER_FEE_MULTIPLIER=0.0
SIM_LATENCY_MS=250
SIM_LATENCY_PRICE_DRIFT_PER_SECOND=0.004
SIM_MAX_LATENCY_SLIPPAGE=0.01
SIM_MAX_EXECUTION_SLIPPAGE=0.03
SIM_MIN_FILL_FRACTION=0.25

# V0.6 data health / shadow lab
REQUIRE_ORDERBOOK_FOR_ENTRY=true
MIN_EXECUTION_SIDE_DEPTH=1
MAX_SOURCE_DISPERSION=0.003
MAX_MARKET_SNAPSHOT_AGE_SECONDS=5

# V0.7 empirical execution learning
ORDERBOOK_STREAM_STALE_SECONDS=2
EMPIRICAL_QUOTE_HORIZONS_MS=100,250,500,1000
EMPIRICAL_LATENCY_MIN_SAMPLES=200
# Keep false until enough real quote-move samples exist and have been reviewed.
USE_EMPIRICAL_LATENCY=false
AUTO_MODEL_TRAIN=true
AUTO_TRAIN_EVERY_WINDOWS=16

# V0.8 chronological strategy replay / paper-research gates
STRATEGY_EVAL_REPORT_PATH=data/strategy_eval.json
STRATEGY_EVAL_MAX_REPORT_TRADES=500
SOAK_MIN_COMPLETED_WINDOWS=200
SOAK_MIN_REPLAY_TRADES=50
SOAK_MIN_BRIER_GAIN=0.0
SOAK_REQUIRE_POSITIVE_REPLAY_PNL=true
SOAK_MAX_REPLAY_DRAWDOWN_FRACTION=0.10
SOAK_MAX_CONSECUTIVE_LOSSES=10
SOAK_MIN_EXECUTION_FILL_RATE=0.50
SOAK_MIN_EMPIRICAL_SAMPLES=500

# V0.9 fast in-memory decision path.
# The slow REST/reconciliation loop stays at ENGINE_INTERVAL_SECONDS. This loop
# only consumes already-synced WebSocket/BRTI state, so 200ms does not hammer
# Kalshi/Coinbase/Kraken REST endpoints.
FAST_PATH_ENABLED=true
FAST_PATH_INTERVAL_MS=200
FAST_PATH_REQUIRE_STREAM=true
FAST_PATH_OBSERVATION_INTERVAL_SECONDS=1
FAST_PATH_MAX_SLOW_STATE_AGE_SECONDS=4

# Optional AI/time-series sidecar.
# Recommended model: Amazon Chronos-2. Run it as a separate HTTP service so its
# inference latency can never block the 200ms trading path. Expected response:
# {"ticker":"KXBTC15M-...","yes_probability":0.63,"confidence":0.72,
#  "model":"amazon/chronos-2","rationale":["..."]}
AI_SIDECAR_ENABLED=false
AI_SIDECAR_URL=
AI_SIDECAR_MODEL=amazon/chronos-2
AI_SIDECAR_WEIGHT=0.20
AI_SIDECAR_MIN_CONFIDENCE=0.55
AI_SIDECAR_REQUEST_INTERVAL_SECONDS=5
AI_SIDECAR_TIMEOUT_SECONDS=2
AI_SIDECAR_MAX_AGE_SECONDS=15
AI_SIDECAR_MAX_PROBABILITY_SHIFT=0.08
AI_SIDECAR_HISTORY_POINTS=256

# Public spot cross-check feeds
COINBASE_SPOT_URL=https://api.coinbase.com/v2/prices/BTC-USD/spot
KRAKEN_TICKER_URL=https://api.kraken.com/0/public/Ticker?pair=XBTUSD
