# Runtime
APP_HOST=0.0.0.0
APP_PORT=8000
ENGINE_INTERVAL_SECONDS=5
DATABASE_PATH=data/k_trading.sqlite3

# Kalshi public market data (no key required)
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_SERIES_TICKER=
MARKET_TICKER_OVERRIDE=

# Paper trading only in V1
PAPER_STARTING_CASH=1000
AUTO_PAPER_TRADE=true
LIVE_TRADING_ENABLED=false

# Strategy
MIN_USABLE_EDGE=0.04
EXIT_EDGE=0.01
UNCERTAINTY_BUFFER=0.02
ESTIMATED_COST_BUFFER=0.01
MAX_SPREAD=0.12
MAX_POSITION_USD=15
MAX_BANKROLL_FRACTION=0.015
MIN_SECONDS_TO_EXPIRY=45
MAX_TRADE_LOSS_FRACTION=0.25
DAILY_LOSS_LIMIT_USD=50
MAX_DRAWDOWN_FRACTION=0.10

# BTC proxy feeds. V1 uses multiple public spot feeds as features only.
COINBASE_SPOT_URL=https://api.coinbase.com/v2/prices/BTC-USD/spot
KRAKEN_TICKER_URL=https://api.kraken.com/0/public/Ticker?pair=XBTUSD
